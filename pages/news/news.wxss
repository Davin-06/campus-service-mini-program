.container {
  min-height: 100vh;
  background: #f5f7fa;
  margin: 0;
  padding: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.header {
  background: #ffffff;
  padding: 100rpx 40rpx 30rpx;
  text-align: center;
  margin-top: -20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.search-bar {
  padding: 20rpx 30rpx;
  background: #ffffff;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  border: 1rpx solid #e8e8e8;
}

.search-icon {
  font-size: 32rpx;
  opacity: 0.5;
  margin-right: 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: transparent;
}

.search-clear {
  font-size: 36rpx;
  color: #999;
  padding: 0 10rpx;
}

.category-bar {
  background: #ffffff;
  padding: 20rpx 20rpx;
  white-space: nowrap;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  border-radius: 50rpx;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  background: #f5f7fa;
}

.category-text {
  font-size: 30rpx;
  color: #666;
}

.category-item.active {
  background: #42A5F5;
}

.category-item.active .category-text {
  color: #ffffff;
  font-weight: bold;
}

.news-list {
  height: calc(100vh - 340rpx);
  padding: 24rpx;
  margin: 0;
  width: 100%;
  box-sizing: border-box;
}

.news-item {
  margin-bottom: 24rpx;
  width: 100%;
}

.news-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  width: 100%;
  margin: 0 auto;
  display: flex;
  transition: transform 0.2s, box-shadow 0.2s;
}

.news-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.news-content {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

.news-image-wrap {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
}

.news-image {
  width: 100%;
  height: 100%;
  border-radius: 0 16rpx 16rpx 0;
}

.news-image image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 16rpx 16rpx 0;
}

.placeholder-icon {
  font-size: 48rpx;
  color: #ccc;
}

.news-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.5;
}

.news-summary {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.6;
}

.news-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.news-date {
  font-size: 24rpx;
  color: #999999;
}

.news-views {
  font-size: 24rpx;
  color: #999999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
}

.loading-more-text {
  font-size: 26rpx;
  color: #ccc;
}

.robot-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 9998;
}

.robot-area movable-view {
  pointer-events: auto;
}
