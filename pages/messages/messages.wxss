.container {
  min-height: 100vh;
  background: #ffffff;
}

.header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 30rpx 30rpx;
  background: linear-gradient(180deg, #87CEEB 0%, #E0F4FF 100%);
  position: relative;
  margin-top: -20rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #000;
}

.header-badge {
  position: absolute;
  top: 40rpx;
  right: 30rpx;
  min-width: 36rpx;
  height: 36rpx;
  background: #ff6b6b;
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 25rpx 0;
  position: relative;
}

.tab-text {
  font-size: 30rpx;
  color: #666;
  transition: color 0.3s ease;
}

.tab-item.active .tab-text {
  color: #667eea;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
}

.tab-badge {
  min-width: 28rpx;
  height: 28rpx;
  background: #ff6b6b;
  border-radius: 14rpx;
  font-size: 20rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  padding: 0 8rpx;
}

.message-list {
  padding: 20rpx;
  height: calc(100vh - 200rpx);
}

.message-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 25rpx;
  margin-bottom: 15rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s ease;
}

.message-item:active {
  transform: scale(0.98);
}

.avatar-wrapper {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid #f0f0f0;
}

.type-icon {
  position: absolute;
  bottom: -5rpx;
  right: -5rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  border: 3rpx solid #fff;
}

.type-icon.like {
  background: #ff6b6b;
}

.type-icon.comment {
  background: #667eea;
}

.type-icon.follow {
  background: #8BC34A;
}

.message-content {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.message-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.message-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.post-title {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.comment-content {
  font-size: 26rpx;
  color: #667eea;
  display: block;
}

.arrow {
  font-size: 40rpx;
  color: #ddd;
  margin-left: 10rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.robot-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 9998;
}

.robot-area movable-view {
  pointer-events: auto;
}
