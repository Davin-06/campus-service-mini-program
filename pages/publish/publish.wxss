.container {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 120rpx;
}

.header {
  background: #ffffff;
  padding: 100rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-content {
  display: flex;
  align-items: center;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.form-section {
  padding: 20rpx 30rpx;
}

.form-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #f0f0f0;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.type-selector {
  display: flex;
  gap: 16rpx;
}

.type-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.type-option.active {
  background: #E3F2FD;
  border-color: #42A5F5;
}

.type-icon-box {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
  position: relative;
}

.type-icon-box.question {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #999;
  border-radius: 50%;
  position: relative;
}

.type-icon-box.question::after {
  content: '?';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 24rpx;
  font-weight: bold;
  color: #999;
}

.type-icon-box.share {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #999;
  border-radius: 8rpx;
  position: relative;
}

.type-icon-box.share::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  right: 10rpx;
  height: 4rpx;
  background: #999;
}

.type-icon-box.share::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 10rpx;
  right: 10rpx;
  height: 4rpx;
  background: #999;
}

.type-icon-box.discussion {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #999;
  border-radius: 8rpx;
  position: relative;
}

.type-icon-box.discussion::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 10rpx;
  right: 10rpx;
  height: 4rpx;
  background: #999;
}

.type-icon-box.discussion::after {
  content: '';
  position: absolute;
  top: 24rpx;
  left: 10rpx;
  right: 16rpx;
  height: 4rpx;
  background: #999;
}

.type-icon-box.lost {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #999;
  border-radius: 50%;
  position: relative;
}

.type-icon-box.lost::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #999;
  border-radius: 50%;
}

.type-icon-box.lost::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  width: 8rpx;
  height: 8rpx;
  background: #999;
  border-radius: 50%;
}

.type-option.active .type-icon-box {
  border-color: #42A5F5;
}

.type-option.active .type-icon-box::before,
.type-option.active .type-icon-box::after {
  background: #42A5F5;
}

.type-option.active .type-icon-box.question::after,
.type-option.active .type-icon-box.lost::after {
  color: #42A5F5;
}

.type-text {
  font-size: 24rpx;
  color: #666;
}

.type-option.active .type-text {
  color: #42A5F5;
  font-weight: bold;
}

.input {
  width: 100%;
  padding: 20rpx;
  font-size: 28rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  background: #fafafa;
}

.textarea {
  width: 100%;
  min-height: 280rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  background: #fafafa;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.image-uploader {
  display: flex;
  flex-direction: column;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  backdrop-filter: blur(4rpx);
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #d0d0d0;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.add-icon {
  font-size: 64rpx;
  color: #ccc;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999;
}

.upload-tip {
  font-size: 22rpx;
  color: #999;
}

.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.publish-btn {
  width: 100%;
  background: #42A5F5;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: bold;
  padding: 24rpx;
}

.publish-btn[disabled] {
  background: #e0e0e0;
  color: #999;
}

.robot-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 9998;
}

.robot-area movable-view {
  pointer-events: auto;
}
