page {
  margin: 0;
  padding: 0;
  width: 100%;
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #e8f0f5 50%, #f0f4f8 100%);
  padding: 0;
  margin: 0;
  width: 100%;
  box-sizing: border-box;
}

.header {
  position: relative;
  padding: 80rpx 30rpx 20rpx;
  background: linear-gradient(180deg, #87CEEB 0%, #E0F4FF 100%);
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.back-btn {
  font-size: 40rpx;
  color: #333;
  padding: 10rpx;
}

.header-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #2d3748;
  text-align: center;
  letter-spacing: 2rpx;
}

.progress-bar {
  height: 3rpx;
  background: rgba(0, 0, 0, 0.06);
  width: 100%;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  width: 0;
  border-radius: 2rpx;
}

.news-content {
  padding: 25rpx 20rpx;
  height: calc(100vh - 150rpx);
  width: 100%;
  box-sizing: border-box;
}

.news-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.08);
  border: 1rpx solid rgba(230, 230, 230, 0.5);
  margin: 0 auto;
}

.news-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #1a202c;
  line-height: 1.5;
  margin-bottom: 25rpx;
  text-align: left;
  letter-spacing: 0.5rpx;
}

.news-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.meta-icon {
  font-size: 24rpx;
  filter: grayscale(100%);
  opacity: 0.6;
}

.meta-text {
  font-size: 24rpx;
  color: #718096;
}

.meta-divider {
  width: 1rpx;
  height: 24rpx;
  background: rgba(0, 0, 0, 0.08);
}

.article-content {
  margin-bottom: 30rpx;
}

.paragraph {
  font-size: 30rpx;
  color: #4a5568;
  line-height: 1.8;
  text-indent: 60rpx;
  margin-bottom: 25rpx;
  text-align: justify;
  letter-spacing: 0.3rpx;
}

.article-footer {
  padding-top: 25rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3748;
}

.stat-label {
  font-size: 22rpx;
  color: #a0aec0;
}

.bottom-space {
  height: 40rpx;
}

.robot-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 9998;
}

.robot-area movable-view {
  pointer-events: auto;
}