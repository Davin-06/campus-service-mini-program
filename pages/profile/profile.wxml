<view class="container">
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view wx:if="{{userInfo.name}}" class="user-card">
        <view class="avatar-section" bindtap="editAvatar">
          <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        </view>
        <view class="user-info">
          <text class="user-name" bindtap="editName">{{userInfo.name}}</text>
          <text class="user-tag" bindtap="editTag">{{userInfo.tag || '编辑简历'}}</text>
        </view>
        <view class="settings-btn" bindtap="goToSettings">
          <text class="icon">⚙</text>
        </view>
      </view>
      
      <view wx:if="{{userInfo.name}}" class="stats-row">
        <view class="stat-item" bindtap="goToMyPosts">
          <text class="stat-value">{{stats.posts}}</text>
          <text class="stat-label">我的发布</text>
        </view>
        <view class="stat-item" bindtap="goToMyLikes">
          <text class="stat-value">{{stats.likes}}</text>
          <text class="stat-label">我的收藏</text>
        </view>
        <view class="stat-item" bindtap="goToMyFollows">
          <text class="stat-value">{{stats.follows}}</text>
          <text class="stat-label">我的关注</text>
        </view>
        <view class="stat-item" bindtap="goToHistory">
          <text class="stat-value">{{stats.history}}</text>
          <text class="stat-label">浏览记录</text>
        </view>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-card">
      <text class="menu-title">常用功能</text>
      <view class="menu-grid">
        <view class="menu-item" bindtap="goToMyPosts">
          <view class="menu-icon-box">
            <view class="icon-post"></view>
          </view>
          <text class="menu-text">我的帖子</text>
        </view>
        <view class="menu-item" bindtap="goToMyReplies">
          <view class="menu-icon-box">
            <view class="icon-chat"></view>
          </view>
          <text class="menu-text">我的回复</text>
        </view>
        <view class="menu-item" bindtap="goToMyLikes">
          <view class="menu-icon-box">
            <view class="icon-star"></view>
          </view>
          <text class="menu-text">我的收藏</text>
        </view>
        <view class="menu-item" bindtap="goToLikes">
          <view class="menu-icon-box">
            <view class="icon-thumbs"></view>
          </view>
          <text class="menu-text">点赞记录</text>
        </view>
        <view class="menu-item" bindtap="goToHistory">
          <view class="menu-icon-box">
            <view class="icon-clock"></view>
          </view>
          <text class="menu-text">浏览记录</text>
        </view>
        <view class="menu-item" bindtap="goToTrash">
          <view class="menu-icon-box">
            <view class="icon-trash"></view>
          </view>
          <text class="menu-text">草稿箱</text>
        </view>
        <view class="menu-item" bindtap="goToNotifications">
          <view class="menu-icon-box">
            <view class="icon-bell"></view>
          </view>
          <text class="menu-text">消息通知</text>
        </view>
        <view class="menu-item" bindtap="goToHelp">
          <view class="menu-icon-box">
            <view class="icon-help"></view>
          </view>
          <text class="menu-text">帮助与反馈</text>
        </view>
      </view>
    </view>

    <view class="menu-card">
      <view class="menu-list">
        <view class="menu-row" bindtap="goToActivities">
          <view class="row-icon-wrap"><view class="row-icon-calendar"></view></view>
          <text class="row-text">我的活动</text>
          <text class="row-arrow">›</text>
        </view>
        <view class="menu-row" bindtap="goToLost">
          <view class="row-icon-wrap"><view class="row-icon-search"></view></view>
          <text class="row-text">失物招领</text>
          <text class="row-arrow">›</text>
        </view>
        <view class="menu-row" bindtap="goToSuggestions">
          <view class="row-icon-wrap"><view class="row-icon-lightbulb"></view></view>
          <text class="row-text">意见建议</text>
          <text class="row-arrow">›</text>
        </view>
        <view class="menu-row" bindtap="goToAbout">
          <view class="row-icon-wrap"><view class="row-icon-user"></view></view>
          <text class="row-text">关于我们</text>
          <text class="row-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="login-section" wx:if="{{!userInfo.name}}">
    <button class="login-btn" bindtap="login">
      <view class="login-icon-box">
        <view class="login-icon"></view>
      </view>
      <text class="login-text">微信登录</text>
    </button>
  </view>

  <view class="logout-section" wx:if="{{userInfo.name}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <movable-area class="robot-area">
    <movable-view 
      class="robot-button" 
      x="{{robotX}}" 
      y="{{robotY}}" 
      direction="all"
      binddragend="onRobotDragEnd"
    >
      <image src="/images/robot.png" mode="aspectFill" bindtap="onRobotTap"></image>
    </movable-view>
  </movable-area>
</view>