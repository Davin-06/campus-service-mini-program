.container {
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  background: #ffffff;
  padding: 100rpx 40rpx 30rpx;
  text-align: center;
  margin-top: -20rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 20rpx;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  position: relative;
}

.tab-text {
  font-size: 28rpx;
  color: #666;
}

.tab-item.active .tab-text {
  color: #42A5F5;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 50rpx;
  height: 4rpx;
  background: #42A5F5;
  border-radius: 2rpx;
}

.category-bar {
  background: #ffffff;
  padding: 20rpx 20rpx;
  white-space: nowrap;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  border-radius: 50rpx;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  background: #f5f7fa;
}

.category-text {
  font-size: 30rpx;
  color: #666;
}

.category-item.active {
  background: #42A5F5;
}

.category-item.active .category-text {
  color: #ffffff;
  font-weight: bold;
}

.fab-container {
  position: fixed;
  bottom: 180rpx;
  right: 30rpx;
  z-index: 100;
}

.fab-btn {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #42A5F5 0%, #64B5F6 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(66, 165, 245, 0.4);
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

.post-list {
  height: calc(100vh - 280rpx);
  padding: 20rpx;
}

.post-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f5f5f5;
}

.author-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.author-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.author-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.author-tag {
  font-size: 22rpx;
  color: #42A5F5;
  background: #E3F2FD;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.post-time {
  font-size: 24rpx;
  color: #999999;
}

.post-content {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.7;
  margin-bottom: 20rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.post-images {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.post-image-wrapper {
  width: calc(33.33% - 8rpx);
  padding-bottom: calc(33.33% - 8rpx);
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.post-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.post-footer {
  display: flex;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.footer-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.footer-icon {
  font-size: 36rpx;
}

.footer-text {
  font-size: 28rpx;
  color: #666666;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.robot-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 9998;
}

.robot-area movable-view {
  pointer-events: auto;
}
